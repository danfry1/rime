  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5f6b7e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#98d4c4"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#d4c28c"
      }
    },
    {
      "scope": ["constant.language", "constant.character"],
      "settings": {
        "foreground": "#cdbb9a"
      }
    },
    {
      "scope": ["constant.other"],
      "settings": {
        "foreground": "#cdbb9a"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.language"],
      "settings": {
        "foreground": "#cdd9e5"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#cdd9e5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#cdd9e5"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a6a6d4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#c49ab0"
      }
    },
    {
      "scope": ["keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison", "keyword.operator.ternary"],
      "settings": {
        "foreground": "#c49ab0"
      }
    },
    {
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": {
        "foreground": "#a6a6d4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["support.type.primitive"],
      "settings": {
        "foreground": "#a6a6d4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#cdbb9a"
      }
    },
    {
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "foreground": "#cdbb9a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82bce0"
      }
    },
    {
      "scope": ["entity.name.function.method", "meta.function-call"],
      "settings": {
        "foreground": "#82bce0"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#7ec4be"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#82bce0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#7d8a9c"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#7ec4be"
      }
    },
    {
      "scope": [
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#7ec4be"
      }
    },
    {
      "scope": ["entity.name.tag.css", "support.type.property-name.css"],
      "settings": {
        "foreground": "#82bce0"
      }
    },
    {
      "scope": ["support.constant.property-value.css", "constant.other.color.rgb-value.css"],
      "settings": {
        "foreground": "#cdbb9a"
      }
    },
    {
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": {
        "foreground": "#d4c28c"
      }
    },
    {
      "scope": ["entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"],
      "settings": {
        "foreground": "#7ec4be"
      }
    },
    {
      "scope": ["markup.heading", "markup.heading.setext"],
      "settings": {
        "foreground": "#a6a6d4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#cdbb9a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#c49ab0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#98d4c4"
      }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#82bce0"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#98d4c4"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#cc8e84"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#82bce0"
      }
    },
    {
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#c49ab0"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#a6b3c2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["meta.separator"],
      "settings": {
        "foreground": "#7d8a9c"
      }
    },
    {
      "scope": ["meta.diff.header"],
      "settings": {
        "foreground": "#82bce0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["invalid"],
      "settings": {
        "foreground": "#cc8e84"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#7d8a9c",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#cdbb9a",
    "class": "#cdbb9a",
    "enum": "#cdbb9a",
    "interface": { "foreground": "#cdbb9a", "fontStyle": "italic" },
    "struct": "#cdbb9a",
    "typeParameter": { "foreground": "#cdbb9a", "fontStyle": "italic" },
    "parameter": "#cdd9e5",
    "variable": "#cdd9e5",
    "property": "#cdd9e5",
    "enumMember": "#cdbb9a",
    "decorator": "#cdbb9a",
    "function": "#82bce0",
    "method": "#82bce0",
    "macro": "#7ec4be",
    "namespace": "#cdd9e5",
    "keyword": { "foreground": "#a6a6d4", "fontStyle": "italic" },
    "comment": { "foreground": "#5f6b7e", "fontStyle": "italic" },
    "string": "#98d4c4",
    "number": "#d4c28c",
    "operator": "#c49ab0",
    "variable.readonly": "#cdd9e5",
    "property.readonly": { "foreground": "#cdd9e5", "fontStyle": "italic" },
    "function.defaultLibrary": { "foreground": "#82bce0", "fontStyle": "italic" },
    "variable.defaultLibrary": { "foreground": "#cdd9e5", "fontStyle": "italic" }
  }
}
