{
  "name": "rime",
  "version": "0.1.0",
  "description": "A muted, cool-toned dark theme for editors, terminals, and CLI tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/rime.git"
  },
  "homepage": "https://github.com/danfry1/rime",
  "bugs": {
    "url": "https://github.com/danfry1/rime/issues"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "init-theme": "bun run scripts/init-theme.ts",
    "test": "bun test",
    "validate": "bun scripts/generate.ts --validate-only",
    "check": "bun scripts/generate.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["color-theme", "terminal", "neovim", "tmux", "dark-theme"],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "mustache": "4.2.0"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "bun-types": "1.4.0",
    "typescript": "6.0.3"
  }
}
